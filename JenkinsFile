pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                sh 'chmod +x mvnw'
                sh './mvnw clean package -DskipTests'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    mkdir -p /var/lib/jenkins/cicd-demo-2

                    # Stop existing cicd-demo-2 application
                    if [ -f /var/lib/jenkins/cicd-demo-2/app.pid ]; then
                        kill $(cat /var/lib/jenkins/cicd-demo-2/app.pid) || true
                        rm -f /var/lib/jenkins/cicd-demo-2/app.pid
                        sleep 5
                    fi

                    # Copy new JAR
                    cp target/cicd-demo-2-0.0.1-SNAPSHOT.jar \
                       /var/lib/jenkins/cicd-demo-2/app.jar

                    # Start application and prevent Jenkins from killing it
                    JENKINS_NODE_COOKIE=dontKillMe \
                    nohup java -jar /var/lib/jenkins/cicd-demo-2/app.jar \
                    > /var/lib/jenkins/cicd-demo-2/app.log 2>&1 &

                    echo $! > /var/lib/jenkins/cicd-demo-2/app.pid

                    sleep 10

                    echo "===== Application Log ====="
                    cat /var/lib/jenkins/cicd-demo-2/app.log

                    echo "===== Port Check ====="
                    ss -lntp | grep 8083 || true
                '''
            }
        }
    }
}